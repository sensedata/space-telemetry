{
  "name": "space-telemetry",
  "license": "MIT",

  "author": "SenseData <hello@sensedata.com> (https://sensedata.com)",
  "contributors": [
    "Matthew Jones <matt@sensedata.com>",
    "Yuri Gadow <hello@ylg.dev>"
  ],

  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/sensedata/space-telemetry"
  },

  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",

  "scripts": {
    "build": "vite build",
    "deps": "depcruise src",
    "format": "biome format --write .",
    "lint": "eslint . && biome lint . && biome format .",
    "lint:fix": "eslint --fix . && biome lint --write .",
    "start": "pnpm build && node src/server/server.ts",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --coverage --coverage.reportsDirectory reports/coverage/integration --project integration",
    "test:mutation": "stryker run",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory reports/coverage/unit --project unit-server --project unit-client",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },

  "dependencyComments": {
    "lightstreamer-client-node": [
      "reassess risk frequently; depends directly on an ",
      "individual's GitHub master without integrity hash or audit"
    ],
    "xmlhttprequest": [
      "the only exotic (git) sub-dependency permitted; reaches us through ",
      "lightstreamer-client-node, and blockExoticSubdeps: false in ",
      "pnpm-workspace.yaml exists for it alone"
    ],

    "@playwright/test": "when bumping past 1.63, recheck #42768 and playwright.config.ts",
    "typescript": "stay on 6 until modernization complete and all final deps pass 7 compat",
    "vitest": "stryker-js#6210 blocks vitest 5; @vitest/coverage-v8 moves with it as a matched pair"
  },
  "dependencies": {
    "lightstreamer-client-node": "^9.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7",
    "@eslint/js": "^10.0",
    "@playwright/test": "^1.63",
    "@stryker-mutator/api": "^10.0",
    "@stryker-mutator/core": "^10.0",
    "@stryker-mutator/typescript-checker": "^10.0",
    "@stryker-mutator/vitest-runner": "^10.0",
    "@types/d3-array": "^3.2",
    "@types/d3-scale": "^4.0",
    "@types/d3-shape": "^3.2",
    "@types/eslint-plugin-no-unsanitized": "^4.1",
    "@types/eslint-plugin-security": "^3.0",
    "@types/luxon": "^3.7",
    "@types/node": "^26.6",
    "@types/three": "^0.186",
    "@vitest/coverage-v8": "^4.1",
    "@vitest/eslint-plugin": "^1.6",
    "d3-array": "^3.2",
    "d3-scale": "^4.0",
    "d3-shape": "^3.2",
    "dependency-cruiser": "^18.2",
    "eslint": "^10.9",
    "eslint-import-resolver-typescript": "^4.4",
    "eslint-plugin-import-x": "^4.17",
    "eslint-plugin-jsdoc": "^65.0",
    "eslint-plugin-no-unsanitized": "^4.1",
    "eslint-plugin-security": "^4.0",
    "eslint-plugin-unicorn": "^76.0",
    "globals": "^17.12",
    "jiti": "^2.7",
    "jsdom": "^30.1",
    "knip": "^6.34",
    "luxon": "^3.7",
    "preact": "^10.29",
    "three": "^0.186",
    "typescript": "^6.0",
    "typescript-eslint": "^8.69",
    "vite": "^8.3",
    "vitest": "^4.1"
  }
}
